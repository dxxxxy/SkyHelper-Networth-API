				"additionalProperties": false
			},
			"NetworthOptions": {
				"properties": {
					"prices": {
						"additionalProperties": false,
						"type": "object",
						"description": "A prices object generated from the getPrices function. If not provided, the prices will be retrieved every time the function is called.\nDefault: undefined"
					},
					"cachePrices": {
						"type": "boolean",
						"description": "Whether to cache the prices for 5 minutes after fetching them or fetch them every time. Can also be a number to cache the prices for a specific amount of time in milliseconds.\nDefault: true"
					},
					"pricesRetries": {
						"type": "number",
						"format": "double",
						"description": "The amount of retries to fetch the prices when failing to fetch them.\nDefault: 3"
					},
					"onlyNetworth": {
						"type": "boolean",
						"description": "Whether to only return the networth values and not the item calculations\nDefault: false"
					},
					"includeItemData": {
						"type": "boolean",
						"description": "Whether to include the item data as a property in the item object.\nDefault: false"
					},
					"sortItems": {
						"type": "boolean",
						"description": "Whether to sort items by price.\nDefault: true"
					},
					"stackItems": {
						"type": "boolean",
						"description": "Whether to stack items with the same name and price.\nDefault: true"
					}
				},
				"type": "object",
				"additionalProperties": false
			},
