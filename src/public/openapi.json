			"NetworthResult": {
				"properties": {
					"networth": {
						"type": "number",
						"format": "double",
						"description": "The total networth of the player."
					},
					"unsoulboundNetworth": {
						"type": "number",
						"format": "double",
						"description": "The total networth of the player without the soulbound items."
					},
					"noInventory": {
						"type": "boolean",
						"description": "Whether the player has inventory API disabled or not."
					},
					"isNonCosmetic": {
						"type": "boolean",
						"description": "Whether the non cosmetic items are included in the networth calculation."
					},
					"purse": {
						"type": "number",
						"format": "double",
						"description": "The purse balance of the player."
