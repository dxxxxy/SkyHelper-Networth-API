			"Calculation": {
				"properties": {
					"soulbound": {
						"type": "boolean",
						"description": "Whether this part of the calculation is soulbound."
					},
					"star": {
						"type": "number",
						"format": "double",
						"description": "The amount of stars on the item."
					},
					"shards": {
						"type": "number",
						"format": "double",
						"description": "The amount of Attribute Shards on the item."
					},
					"count": {
						"type": "number",
						"format": "double",
						"description": "The amount of the item modifier."
					},
					"price": {
						"type": "number",
						"format": "double",
						"description": "The value of the item modifier."
					},
					"type": {
						"type": "string",
						"description": "The id of the item modifier."
					},
					"id": {
						"type": "string",
						"description": "The name of the item modifier."
					}
				},
				"required": [
					"count",
					"price",
					"type",
					"id"
				],
				"type": "object"
			},
			"Item": {
				"properties": {
					"petData": {
						"additionalProperties": false,
						"type": "object",
						"description": "The pet data of the item.\nOnly included if the includeItemData option is true."
					},
					"item": {
						"additionalProperties": false,
						"type": "object",
						"description": "The item data of the item.\nOnly included if the includeItemData option is true."
					},
					"cosmetic": {
						"type": "boolean",
						"description": "Whether the item is cosmetic or not."
					},
					"soulbound": {
						"type": "boolean",
						"description": "Whether the item is soulbound or not."
					},
					"count": {
						"type": "number",
						"format": "double",
						"description": "The amount of the item"
					},
					"calculation": {
						"items": {
							"$ref": "#/components/schemas/Calculation"
						},
						"type": "array",
						"description": "The calculation of the item."
					},
					"soulboundPortion": {
						"type": "number",
						"format": "double",
						"description": "The soulbound portion of the item. This is present when part of an item is soulbound but the item itself is not."
					},
					"price": {
						"type": "number",
						"format": "double",
						"description": "The price of the item."
					},
					"basePrice": {
						"type": "number",
						"format": "double",
						"description": "The base price of the item."
					},
					"id": {
						"type": "string",
						"description": "The id of the item."
					},
					"loreName": {
						"type": "string",
						"description": "The display name of the item."
					},
					"name": {
						"type": "string",
						"description": "The name of the item."
					}
				},
				"required": [
					"cosmetic",
					"soulbound",
					"count",
					"calculation",
					"price",
					"basePrice",
					"id",
					"loreName",
					"name"
				],
				"type": "object"
			},
			"Inventory": {
